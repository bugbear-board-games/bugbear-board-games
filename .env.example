# Database. SQLite for local development.
# For production, switch the provider in prisma/schema.prisma to "postgresql"
# and use a Postgres URL (e.g. from Neon, Supabase, or Railway).
DATABASE_URL="file:./dev.db"

# The seed script creates the Owner account from these (only if no Owner exists yet).
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD="change-me-please"
OWNER_NAME="Site Owner"
