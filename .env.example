# Database: Postgres on Neon (https://neon.tech). Fill these with `neon env pull --branch dev`
# (local) or let Vercel's Neon integration set them (production). Locally, always use the
# "dev" branch; "main" is production.
# DATABASE_URL:          pooled connection string (host contains "-pooler"); used by the app.
# DATABASE_URL_UNPOOLED: direct connection string; used for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require"

# The seed script creates the Owner account from these, only if no Owner exists yet.
# Production refuses these placeholder values.
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD="change-me-please"
OWNER_NAME="Site Owner"
